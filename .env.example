# Sahaay AI Environment Configuration

# Backend Configuration
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./sahaay.db
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# External APIs
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# Computer Vision Model Mode
# Options: "local_feature_extractor", "huggingface_inference", "onnx"
VISION_MODEL_MODE=local_feature_extractor

# Admin Initial Credentials
DEFAULT_ADMIN_EMAIL=admin@sahaay.org
DEFAULT_ADMIN_PASSWORD=admin123

# Frontend Vite Configuration
VITE_API_BASE_URL=/api
